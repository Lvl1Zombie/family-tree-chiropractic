# Family Tree Chiropractic — Apache config for GoDaddy shared hosting.
# Upload this file to the same folder as index.html (usually public_html).
# Apache hides dotfiles by default, so confirm it transferred via the
# cPanel File Manager (enable "Show Hidden Files").

# ----------------------------------------------------------------------------
# Canonicalize: force HTTPS and the non-www host so there is exactly one
# address for every page (matches the rel="canonical" tags in the markup).
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Collapse thin/duplicate content into the strongest matching page.
  RewriteRule ^(low-back-pain|chiropractic-care-for-back-pain)\.html$ https://ephratachiropractic.com/back-pain.html [R=301,L]
  RewriteRule ^sciatic-pain-helped-chiropractor\.html$ https://ephratachiropractic.com/sciatica.html [R=301,L]
  RewriteRule ^(chiropractor-talks-about-headaches|chiropractic-clinic-discusses-different-types-headaches|migraine-tips-from-a-chiropractic-clinic)\.html$ https://ephratachiropractic.com/headaches-and-migraines.html [R=301,L]
  RewriteRule ^back-pain-tips-city-chiropractor\.html$ https://ephratachiropractic.com/back-pain.html [R=301,L]
  RewriteRule ^(3-tips-from-your-chiropractor|3-common-conditions-chiropractors-help|5-reasons-to-choose-a-chiropractor|are-you-looking-for-a-chiropractor|the-best-time-to-see-a-chiropractor|why-choose-chiropractic-care|the-value-of-health|time-to-improve-your-health)\.html$ https://ephratachiropractic.com/chiropractic-care.html [R=301,L]

  # Preserve search equity from the former domain with one-to-one redirects.
  # These rules become active when that domain is attached to this hosting
  # account; email-related DNS records are unaffected.
  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^(index\.html)?$ https://ephratachiropractic.com/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^neuropathy-signs-and-symptoms/?$ https://ephratachiropractic.com/neuropathy.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^robots\.txt$ https://ephratachiropractic.com/robots.txt [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^sitemap\.xml$ https://ephratachiropractic.com/sitemap.xml [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^us/?$ https://ephratachiropractic.com/meet-the-doctors.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^about-us/?$ https://ephratachiropractic.com/about-clinic.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^services/?$ https://ephratachiropractic.com/chiropractic-care.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^chiropractic-care-kids/?$ https://ephratachiropractic.com/chiropractic-for-kids.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^(cdl-exams|dot-physicals)/?$ https://ephratachiropractic.com/dot-exams.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^accident-injury-treatments/?$ https://ephratachiropractic.com/accident-injury.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^headaches-migraines/?$ https://ephratachiropractic.com/headaches-and-migraines.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^review-us/?$ https://ephratachiropractic.com/reviews.html [R=301,L]

  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteRule ^healthcare-disclaimer/?$ https://ephratachiropractic.com/hipaa-notice.html [R=301,L]

  # Redirect unchanged slugs only when a real destination file exists.
  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractorfamilytree\.com$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ https://ephratachiropractic.com/$1.html [R=301,L]

  # Do not blanket-410 unmatched legacy URLs. Explicit ranking/content paths
  # are mapped above; anything genuinely unknown can resolve as a normal 404.

  # The filename is an implementation detail; the homepage canonical is `/`.
  RewriteCond %{HTTP_HOST} ^(www\.)?ephratachiropractic\.com$ [NC]
  RewriteRule ^index\.html$ https://ephratachiropractic.com/ [R=301,L]

  # Redirect www -> non-www (https) in one hop.
  RewriteCond %{HTTP_HOST} ^www\.ephratachiropractic\.com [NC]
  RewriteRule ^(.*)$ https://ephratachiropractic.com/$1 [R=301,L]

  # Force HTTPS for any plain-http request.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://ephratachiropractic.com/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------------------
# Custom error page.
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------------
# Default document.
# ----------------------------------------------------------------------------
DirectoryIndex index.html

# ----------------------------------------------------------------------------
# Compression — shrink text assets on the wire.
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------------
# Browser caching — long for static media, short for HTML so content edits
# show up quickly after a re-upload.
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ----------------------------------------------------------------------------
# Security headers (light-touch; safe for a static brochure site).
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
