# Family Tree Chiropractic — Apache config for GoDaddy shared hosting.
# Upload this file to the same folder as index.html (usually public_html).
# Apache hides dotfiles by default, so confirm it transferred via the
# cPanel File Manager (enable "Show Hidden Files").

# ----------------------------------------------------------------------------
# Canonicalize: force HTTPS and the non-www host so there is exactly one
# address for every page (matches the rel="canonical" tags in the markup).
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect www -> non-www (https) in one hop.
  RewriteCond %{HTTP_HOST} ^www\.ephratachiropractic\.com [NC]
  RewriteRule ^(.*)$ https://ephratachiropractic.com/$1 [R=301,L]

  # Force HTTPS for any plain-http request.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://ephratachiropractic.com/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------------------
# Custom error page.
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------------
# Default document.
# ----------------------------------------------------------------------------
DirectoryIndex index.html

# ----------------------------------------------------------------------------
# Compression — shrink text assets on the wire.
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------------
# Browser caching — long for static media, short for HTML so content edits
# show up quickly after a re-upload.
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ----------------------------------------------------------------------------
# Security headers (light-touch; safe for a static brochure site).
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
